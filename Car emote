-- ===== INPUT =====
local steerKeys = {
    [Enum.KeyCode.A]="left",  [Enum.KeyCode.Left]="left",
    [Enum.KeyCode.D]="right", [Enum.KeyCode.Right]="right",
}
local held = { left = false, right = false }

local function updateSteer()
    local s = 0
    if held.left and not held.right then s = -1
    elseif held.right and not held.left then s = 1 end
    if s ~= steering then
        steering = s
        if driveEvent then driveEvent:FireServer("steer", s) end
    end
end

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe or not isDriving then return end
    local k = steerKeys[input.KeyCode]
    if k then held[k] = true; updateSteer() end
end)

UserInputService.InputEnded:Connect(function(input)
    local k = steerKeys[input.KeyCode]
    if k then held[k] = false; updateSteer() end
end)

-- ===== ENTRAR/SAIR =====
local function enterDrive()
    local char = localPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    isDriving, currentGear, steering, heightT = true, 0, 0, 0
    baseCF = hrp.CFrame
    hrp.Anchored = true

    enterBtn.Text = "🚪 Sair do carro"
    enterBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
    statusLabel.Text = "⚪ Marcha N (parado)"
    for _, b in pairs(gearButtons) do b.BackgroundColor3 = Color3.fromRGB(60, 60, 68) end
    gearButtons[0].BackgroundColor3 = Color3.fromRGB(200, 80, 40)

    if driveEvent then driveEvent:FireServer("enter") end
    notify("🚗 Modo direção", "Escolha uma marcha no painel", 3)
end

local function exitDrive()
    if not isDriving then return end
    isDriving = false
    local char = localPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            if baseCF then hrp.CFrame = baseCF end
            hrp.Anchored = false
        end
    end
    enterBtn.Text = "🚗 Entrar no carro"
    enterBtn.BackgroundColor3 = Color3.fromRGB(50, 160, 80)
    statusLabel.Text = "⚪ Parado"
    held.left, held.right = false, false
    if steering ~= 0 then
        steering = 0
        if driveEvent then driveEvent:FireServer("steer", 0) end
    end
    if driveEvent then driveEvent:FireServer("exit") end
end

enterBtn.MouseButton1Click:Connect(function()
    print("[DriveClient] click Enter. isDriving =", isDriving)
    if isDriving then exitDrive() else enterDrive() end
end)

-- ===== MOVIMENTO =====
RunService.Heartbeat:Connect(function(dt)
    if not isDriving then return end
    local char = localPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp or not baseCF then return end

    if heightT < 1 then heightT = math.min(1, heightT + dt / RISE_TIME) end
    local targetY = baseCF.Y + FLOAT_HEIGHT * heightT

    local cf = hrp.CFrame
    cf = cf + Vector3.new(0, targetY - cf.Y, 0)

    local speed = gearSpeeds[currentGear] or 0
    if speed > 0 and steering ~= 0 then
        cf = cf * CFrame.Angles(0, -steering * TURN_SPEED * dt, 0)
    end
    if speed > 0 then
        cf = cf * CFrame.new(0, 0, -speed * dt)
    end
    hrp.CFrame = cf
end)

-- ===== RESPAWN =====
localPlayer.CharacterAdded:Connect(function()
    isDriving, currentGear, steering, heightT, baseCF = false, 0, 0, 0, nil
    enterBtn.Text = "🚗 Entrar no carro"
