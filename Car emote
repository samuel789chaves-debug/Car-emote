}

local MOTOR_PATHS = {
    Waist         = {"LowerTorso",   "Waist"},
    Neck          = {"UpperTorso",   "Neck"},
    RightShoulder = {"UpperTorso",   "RightShoulder"},
    LeftShoulder  = {"UpperTorso",   "LeftShoulder"},
    RightElbow    = {"RightUpperArm","RightElbow"},
    LeftElbow     = {"LeftUpperArm", "LeftElbow"},
    RightWrist    = {"RightLowerArm","RightWrist"},
    LeftWrist     = {"LeftLowerArm", "LeftWrist"},
    RightHip      = {"LowerTorso",   "RightHip"},
    LeftHip       = {"LowerTorso",   "LeftHip"},
    RightKnee     = {"RightUpperLeg","RightKnee"},
    LeftKnee      = {"LeftUpperLeg", "LeftKnee"},
}

local function findMotor(char, name)
    local p = MOTOR_PATHS[name]
    if not p then return nil end
    local parent = char:FindFirstChild(p[1])
    if not parent then return nil end
    local m = parent:FindFirstChild(p[2])
    if m and m:IsA("Motor6D") then return m end
    return nil
end

local function saveDefaults(char)
    defaults = {}
    for name, _ in pairs(MOTOR_PATHS) do
        local m = findMotor(char, name)
        if m then defaults[name] = m.C0 end
    end
end

local function restoreDefaults(char)
    for name, c0 in pairs(defaults) do
        local m = findMotor(char, name)
        if m then m.C0 = c0 end
    end
end

local function notify(title, text, duration)
    pcall(function()
        StarterGui:SetCore("SendNotification", { Title = title, Text = text, Duration = duration or 4 })
    end)
end

