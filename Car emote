local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local driveEvent = ReplicatedStorage:WaitForChild("DriveEvent")

-- ====== CONFIG ======
local ENTER_TIME  = 0.5   -- duração da "entrada no carro"
local SHIFT_TIME  = 0.35  -- duração da mexida do braço
local SHIFT_CURVE = 0.7   -- força da mexida (0–1)

-- Rotação do braço na pose "dirigindo" (relativa à pose original).
-- Se os braços forem pro lado errado, troque os sinais.
local DRIVING_RIGHT = CFrame.Angles(math.rad(-80), 0, math.rad(-10))
local DRIVING_LEFT  = CFrame.Angles(math.rad(-80), 0, math.rad(10))
local SHIFT_DIP     = CFrame.Angles(math.rad(55),  0, math.rad(0))

-- Estado por jogador
local states = {}

-- ====== Helpers ======
local function getShoulder(char, side)
    local torso = char:FindFirstChild("UpperTorso")
    if torso then
        local m = torso:FindFirstChild(side .. "Shoulder")
        if m then return m end
    end
    local arm = char:FindFirstChild(side .. "UpperArm")
    if arm then return arm:FindFirstChild(side .. "Shoulder") end
    return nil
end

local function saveDefaults(char)
    local r, l = getShoulder(char, "Right"), getShoulder(char, "Left")
    return { right = r and r.C0, left = l and l.C0 }
end

local function restoreDefaults(char, def)
    local r, l = getShoulder(char, "Right"), getShoulder(char, "Left")
    if r and def.right then r.C0 = def.right end
    if l and def.left  then l.C0 = def.left  end
end

-- ====== Entrar / Sair ======
local function enter(player)
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    -- Cancela qualquer estado antigo
    if states[player] then
        restoreDefaults(char, states[player].defaults)
    end

    local defaults = saveDefaults(char)

    -- Para animações padrão (idle/walk) que brigariam com nosso C0
    local animator = hum:FindFirstChildOfClass("Animator")
    if animator then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            track:Stop(0)
        end
    end

    hum.PlatformStand = true
    hum:ChangeState(Enum.HumanoidStateType.Physics)

    states[player] = {
        gear      = 0,
        steering  = 0,
        enterT    = 0,  -- 0 → ENTER_TIME
        shiftT    = 0,  -- SHIFT_TIME → 0
        defaults  = defaults,
    }
end

local function exit(player)
    local st = states[player]
    if not st then return end
    local char = player.Character
    if char then
        restoreDefaults(char, st.defaults)
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.PlatformStand = false
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end
    states[player] = nil
end

-- ====== Eventos ======
driveEvent.OnServerEvent:Connect(function(player, action, value)
    if action == "enter" then
        enter(player)
    elseif action == "exit" then
        exit(player)
    elseif action == "gear" then
        local st = states[player]
        if not st then return end
        if typeof(value) ~= "number" or value < 0 or value > 6 then return end
        if st.gear == value then return end
        st.gear = value
        st.shiftT = SHIFT_TIME
    elseif action == "steer" then
        local st = states[player]
        if not st then return end
        st.steering = math.clamp(tonumber(value) or 0, -1, 1)
    end
end)

Players.PlayerRemoving:Connect(function(p) states[p] = nil end)

-- ====== Animação (Heartbeat) ======
RunService.Heartbeat:Connect(function(dt)
    for player, st in pairs(states) do
        local char = player.Character
        if not char or not char.Parent then
            states[player] = nil
            continue
        end

        -- Progresso da "entrada"
        if st.enterT < ENTER_TIME then
            st.enterT = math.min(ENTER_TIME, st.enterT + dt)
        end
        local enterA = st.enterT / ENTER_TIME

        -- Progresso da mexida do braço (sai e volta)
        if st.shiftT > 0 then
            st.shiftT = math.max(0, st.shiftT - dt)
        end
        local shiftA = 0
        if st.shiftT > 0 then
            local t = 1 - (st.shiftT / SHIFT_TIME)     -- 0 → 1
            shiftA = math.sin(t * math.pi) * SHIFT_CURVE -- 0 → 1 → 0
        end

        -- Interpola do default pra pose dirigindo
        local I = CFrame.new()
        local rPose = I:Lerp(DRIVING_RIGHT, enterA)
        local lPose = I:Lerp(DRIVING_LEFT,  enterA)
        -- Adiciona a mexida do braço direito por cima
        rPose = rPose * I:Lerp(SHIFT_DIP, shiftA)

        local r = getShoulder(char, "Right")
        local l = getShoulder(char, "Left")
        if r and st.defaults.right then r.C0 = st.defaults.right * rPose end
        if l and st.defaults.left  then l.C0 = st.defaults.left  * lPose end
    end
end)
