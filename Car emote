-- ===== BOTÕES MOBILE =====
local function makeSteerBtn(side, pos, arrow)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 85, 0, 85)
    btn.Position = pos
    btn.BackgroundColor3 = Color3.fromRGB(60, 130, 220)
    btn.BackgroundTransparency = 0.25
    btn.Text = arrow
    btn.TextColor3 = Color3.new(1,1,1)
    btn.TextSize = 46
    btn.Font = Enum.Font.GothamBold
    btn.BorderSizePixel = 0
    btn.Visible = false
    btn.Parent = screenGui
    Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)

    local function press()
        if not isDriving then return end
        if side == "left" then held.left = true else held.right = true end
        updateSteer()
    end
    local function release()
        if side == "left" then held.left = false else held.right = false end
        updateSteer()
    end
    btn.MouseButton1Down:Connect(press)
    btn.MouseButton1Up:Connect(release)
    btn.MouseLeave:Connect(release)
    return btn
end

local steerLeftBtn  = makeSteerBtn("left",  UDim2.new(0, 30,  1, -150), "◀")
local steerRightBtn = makeSteerBtn("right", UDim2.new(1, -115, 1, -150), "▶")

-- ===== TECLADO (PC) =====
local steerKeys = {
    [Enum.KeyCode.A]="left",  [Enum.KeyCode.Left]="left",
    [Enum.KeyCode.D]="right", [Enum.KeyCode.Right]="right",
}
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe or not isDriving then return end
    local k = steerKeys[input.KeyCode]
    if k then held[k] = true; updateSteer() end
end)
UserInputService.InputEnded:Connect(function(input)
    local k = steerKeys[input.KeyCode]
    if k then held[k] = false; updateSteer() end
end)

-- ===== CHÃO ABAIXO =====
local function groundBelow()
    local char = localPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {char}
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true
    local result = workspace:Raycast(hrp.Position, Vector3.new(0, -500, 0), params)
    if result then return result.Position + Vector3.new(0, 3, 0) end
    return nil
end

-- ===== ENTRAR / SAIR =====
local function enterDrive()
    local char = localPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local animate = char:FindFirstChild("Animate")
    if animate then animate.Disabled = true end

    saveDefaults(char)
    isDriving, currentGear, steering, heightT = true, 0, 0, 0
    enterT, shiftT = 0, 0
    baseCF = hrp.CFrame
    hrp.Anchored = true

    enterBtn.Text = "🚪 Sair do carro"
    enterBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
    statusLabel.Text = "⚪ Marcha N (parado)"
    for _, b in pairs(gearButtons) do b.BackgroundColor3 = Color3.fromRGB(60, 60, 68) end
    gearButtons[0].BackgroundColor3 = Color3.fromRGB(200, 80, 40)
    steerLeftBtn.Visible = true
    steerRightBtn.Visible = true
    notify("🚗 Modo direção", "Escolha uma marcha e use ◀ ▶", 3)
end

local function exitDrive()
    if not isDriving then return end
    isDriving = false

    local char = localPlayer.Character
    if char then
        local groundPos = groundBelow()
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local rotOnly = hrp.CFrame - hrp.CFrame.Position
            if groundPos then
                hrp.CFrame = CFrame.new(groundPos) * rotOnly
            end
            hrp.Anchored = false
        end
        restoreDefaults(char)
        local animate = char:FindFirstChild("Animate")
        if animate then animate.Disabled = false end
    end

    enterBtn.Text = "🚗 Entrar no carro"
    enterBtn.BackgroundColor3 = Color3.fromRGB(50, 160, 80)
    statusLabel.Text = "⚪ Parado"
    steerLeftBtn.Visible = false
    steerRightBtn.Visible = false
    held.left, held.right = false, false
    steering = 0
end

enterBtn.MouseButton1Click:Connect(function()
    if isDriving then exitDrive() else enterDrive() end
end)

-- ===== LOOP PRINCIPAL (anima + move) =====
RunService.Heartbeat:Connect(function(dt)
    if not isDriving then return end
    local char = localPlayer.Character
    if not char then return end

    -- ANIMAÇÃO
    if enterT < ENTER_TIME then enterT = math.min(ENTER_TIME, enterT + dt) end
    local rawA = enterT / ENTER_TIME
    local enterA = 1 - (1 - rawA) ^ 3
    if shiftT > 0 then shiftT = math.max(0, shiftT - dt) end
    local shiftA = 0
    if shiftT > 0 then
        local t = 1 - (shiftT / SHIFT_TIME)
        shiftA = math.sin(t * math.pi)
    end

    local I = CFrame.new()
    for name, pose in pairs(ENTER_POSE) do
        local m = findMotor(char, name)
        if m and defaults[name] then
            local final = I:Lerp(pose, enterA)
            if SHIFT_POSE[name] then
                final = final * I:Lerp(SHIFT_POSE[name], shiftA)
            end
            m.C0 = defaults[name] * final
        end
    end

    -- MOVIMENTO
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp or not baseCF then return end

    if heightT < 1 then heightT = math.min(1, heightT + dt / RISE_TIME) end
    local targetY = baseCF.Y + FLOAT_HEIGHT * heightT

    local cf = hrp.CFrame
    cf = cf + Vector3.new(0, targetY - cf.Y, 0)

    local speed = gearSpeeds[currentGear] or 0
    if speed > 0 and steering ~= 0 then
        cf = cf * CFrame.Angles(0, -steering * TURN_SPEED * dt, 0)
    end
    if speed > 0 then
        cf = cf * CFrame.new(0, 0, -speed * dt)
    end
    hrp.CFrame = cf
end)

