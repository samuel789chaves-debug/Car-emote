-- ==========================================================
-- 🚗 DIREÇÃO — SERVER v3.0
-- ✅ Pose sentada completa (R15: hip, knee, waist, neck, shoulders, elbows)
-- ✅ Braço direito dramatizado na troca de marcha
-- ✅ Logs detalhados de cada Motor6D
-- ==========================================================

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

print("[DriveServer v3] iniciado")

local driveEvent = ReplicatedStorage:FindFirstChild("DriveEvent")
if not driveEvent then
    driveEvent = Instance.new("RemoteEvent")
    driveEvent.Name = "DriveEvent"
    driveEvent.Parent = ReplicatedStorage
end

-- ===== CONFIG TEMPORAL =====
local ENTER_TIME = 0.7
local SHIFT_TIME = 0.45

-- =====================================================
-- POSE DIRIGINDO (sentado)
-- Se algum membro estiver girado pro lado errado,
-- troque o SINAL do número (ex: -80 → 80).
-- =====================================================
local ENTER_POSE = {
    Waist         = CFrame.Angles(math.rad(10),  0, 0),  -- torso inclina pra frente
    Neck          = CFrame.Angles(math.rad(-5),  0, 0),  -- cabeça reta
    RightHip      = CFrame.Angles(math.rad(-90), 0, 0),  -- coxa pra frente
    LeftHip       = CFrame.Angles(math.rad(-90), 0, 0),
    RightKnee     = CFrame.Angles(math.rad(90),  0, 0),  -- canela pra baixo
    LeftKnee      = CFrame.Angles(math.rad(90),  0, 0),
    RightShoulder = CFrame.Angles(math.rad(-80), 0, math.rad(0)),  -- braço pra frente
    LeftShoulder  = CFrame.Angles(math.rad(-80), 0, math.rad(0)),
    RightElbow    = CFrame.Angles(math.rad(-25), 0, 0),  -- cotovelo flexionado
    LeftElbow     = CFrame.Angles(math.rad(-25), 0, 0),
    RightWrist    = CFrame.Angles(math.rad(-15), 0, 0),
    LeftWrist     = CFrame.Angles(math.rad(-15), 0, 0),
}

-- =====================================================
-- DELTA DA TROCA DE MARCHA (aplicado por cima da pose)
-- =====================================================
local SHIFT_POSE = {
    RightShoulder = CFrame.Angles(math.rad(25),  0, math.rad(-10)),
    RightElbow    = CFrame.Angles(math.rad(-45), 0, 0),
    RightWrist    = CFrame.Angles(math.rad(-30), 0, 0),
    Waist         = CFrame.Angles(math.rad(8),   0, 0),
    Neck          = CFrame.Angles(math.rad(-8),  0, 0),
}

-- ===== MAPA DOS MOTORES =====
local MOTOR_PATHS = {
    Waist         = {"LowerTorso",   "Waist"},
    Neck          = {"UpperTorso",   "Neck"},
    RightShoulder = {"UpperTorso",   "RightShoulder"},
    LeftShoulder  = {"UpperTorso",   "LeftShoulder"},
    RightElbow    = {"RightUpperArm","RightElbow"},
    LeftElbow     = {"LeftUpperArm", "LeftElbow"},
    RightWrist    = {"RightLowerArm","RightWrist"},
    LeftWrist     = {"LeftLowerArm", "LeftWrist"},
    RightHip      = {"LowerTorso",   "RightHip"},
    LeftHip       = {"LowerTorso",   "LeftHip"},
    RightKnee     = {"RightUpperLeg","RightKnee"},
    LeftKnee      = {"LeftUpperLeg", "LeftKnee"},
}

local function findMotor(char, name)
    local p = MOTOR_PATHS[name]
    if not p then return nil end
    local parent = char:FindFirstChild(p[1])
    if not parent then return nil end
    local m = parent:FindFirstChild(p[2])
    if m and m:IsA("Motor6D") then return m end
    return nil
end

local function saveDefaults(char)
    local defaults = {}
    local found, missing = 0, {}
    for name, _ in pairs(MOTOR_PATHS) do
        local m = findMotor(char, name)
        if m then
            defaults[name] = m.C0
            found = found + 1
        else
            table.insert(missing, name)
        end
    end
    print(string.format("[DriveServer v3] Motores: %d encontrados, faltando: %s",
        found, #missing > 0 and table.concat(missing, ", ") or "nenhum"))
    return defaults
end

local function restoreDefaults(char, defaults)
    for name, c0 in pairs(defaults) do
        local m = findMotor(char, name)
        if m then m.C0 = c0 end
    end
end

-- ===== ENTER/EXIT =====
local function enter(player)
    local char = player.Character
    if not char or not char:FindFirstChildOfClass("Humanoid") then return end
    if states[player] then restoreDefaults(char, states[player].defaults) end
    local defaults = saveDefaults(char)
    local animate = char:FindFirstChild("Animate")
    if animate then animate.Disabled = true end
    states[player] = { gear = 0, steering = 0, enterT = 0, shiftT = 0, defaults = defaults }
    print("[DriveServer v3] " .. player.Name .. " ENTROU")
end

local function exit(player)
    local st = states[player]
    if not st then return end
    local char = player.Character
    if char then
        restoreDefaults(char, st.defaults)
        local animate = char:FindFirstChild("Animate")
        if animate then animate.Disabled = false end
    end
    states[player] = nil
    print("[DriveServer v3] " .. player.Name .. " SAIU")
end

local states = {}

driveEvent.OnServerEvent:Connect(function(player, action, value)
    if action == "enter" then enter(player)
    elseif action == "exit" then exit(player)
    elseif action == "gear" then
        local st = states[player]
        if not st then return end
        if typeof(value) ~= "number" or value < 0 or value > 6 then return end
        if st.gear == value then return end
        st.gear = value
        st.shiftT = SHIFT_TIME
    elseif action == "steer" then
        local st = states[player]
        if not st then return end
        st.steering = math.clamp(tonumber(value) or 0, -1, 1)
    end
end)

Players.PlayerRemoving:Connect(function(p) states[p] = nil end)

-- ===== ANIMAÇÃO =====
RunService.Heartbeat:Connect(function(dt)
    for player, st in pairs(states) do
        local char = player.Character
        if not char or not char.Parent then
            states[player] = nil
            continue
        end

        if st.enterT < ENTER_TIME then
            st.enterT = math.min(ENTER_TIME, st.enterT + dt)
        end
        local rawA = st.enterT / ENTER_TIME
        local enterA = 1 - (1 - rawA) ^ 3  -- ease-out cubic

        if st.shiftT > 0 then
            st.shiftT = math.max(0, st.shiftT - dt)
        end
        local shiftA = 0
        if st.shiftT > 0 then
            local t = 1 - (st.shiftT / SHIFT_TIME)
            shiftA = math.sin(t * math.pi)
        end

        local I = CFrame.new()

        for name, pose in pairs(ENTER_POSE) do
            local m = findMotor(char, name)
            if m and st.defaults[name] then
                local final = I:Lerp(pose, enterA)
                if SHIFT_POSE[name] then
                    final = final * I:Lerp(SHIFT_POSE[name], shiftA)
                end
                m.C0 = st.defaults[name] * final
            end
        end

        -- Aplica shift também em motores que não têm pose base
        for name, pose in pairs(SHIFT_POSE) do
            if not ENTER_POSE[name] then
                local m = findMotor(char, name)
                if m and st.defaults[name] then
                    m.C0 = st.defaults[name] * I:Lerp(pose, shiftA)
                end
            end
        end
    end
end)
